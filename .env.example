# Copy to .env and adjust before running: cp .env.example .env

POSTGRES_DB=expense_tracker
POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=1440

BACKEND_PORT=8080
FRONTEND_PORT=4200

# Origin the browser loads the app from; used for CORS on the backend.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PrimeNG Community licence key - free for individuals and small teams.
# Generate one at https://primeui.dev. Without it the UI works but shows a licence notice.
PRIMENG_LICENSE=
