# Copy to .env and adjust before running: cp .env.example .env
# Every "change-me" value below is a deliberately invalid placeholder - replace it.
# Generate a strong random value with: openssl rand -base64 48

POSTGRES_DB=expense_tracker
POSTGRES_USER=expense
# Required: docker compose refuses to start without it.
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-48
# Published on 127.0.0.1 only (see docker-compose.yml).
POSTGRES_PORT=5432

# Required, at least 32 characters. Generate with: openssl rand -base64 48
# The backend rejects any secret containing "change-me", so an unedited copy of this file
# fails fast at startup instead of running with a known signing key.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRATION_MINUTES=1440

# Spring profile. Defaults to "prod" (Swagger UI and /v3/api-docs disabled, INFO logging).
# Set to "dev" locally to keep Swagger available.
SPRING_PROFILES_ACTIVE=prod

BACKEND_PORT=8080
FRONTEND_PORT=4200

# Origin the browser loads the app from; used for CORS on the backend.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PrimeNG Community licence key - free for individuals and small teams.
# Generate one at https://primeui.dev. Without it the UI works but shows a licence notice.
PRIMENG_LICENSE=
